# Copy to .env and fill in. Never commit the filled-in file.

# ---- Database ----
# Any PostgreSQL instance. docker compose up brings one up on 5432.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nexmart"

# ---- Auth ----
# Generate one with: openssl rand -base64 32
# The app refuses to start in production if this is left at the default.
JWT_SECRET="change-me-generate-with-openssl-rand-base64-32"

# ---- Stripe ----
# Test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# The signing secret for the webhook endpoint at /api/webhooks/stripe.
# Locally: stripe listen --forward-to localhost:3000/api/webhooks/stripe
# Without this, payments are never confirmed and orders stay pending.
STRIPE_WEBHOOK_SECRET="whsec_..."

# ---- Email (optional) ----
# Order confirmations. Left blank, the app falls back to an Ethereal test inbox
# and logs a preview URL instead of sending anything real.
EMAIL_SERVER=""
EMAIL_PORT="587"
EMAIL_SECURE="false"
EMAIL_USER=""
EMAIL_PASSWORD=""
